# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit actual keys.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service-role key — backend/admin operations only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Site URL ──────────────────────────────────────────────────────────────────
# Used in email links, auto-responders, and unsubscribe URLs.
# Set to https://portal.alwaysready.uk in production; http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://portal.alwaysready.uk

# ── Resend (email) ────────────────────────────────────────────────────────────
# Found in: resend.com → API Keys
RESEND_API_KEY=re_your-api-key-here
# The verified sending address configured in Resend
RESEND_FROM_ADDRESS=AlwaysReady <support@alwaysready.uk>
# Reply-to address — customer replies route here (Cloudflare Email Routing forwards to /api/inbound-email)
RESEND_REPLY_TO=support@alwaysready.uk

# ── Stripe ────────────────────────────────────────────────────────────────────
# Found in: dashboard.stripe.com → Developers → API keys / Webhooks / Products
STRIPE_SECRET_KEY=sk_live_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
STRIPE_PRICE_ID=price_your-standard-price-id
STRIPE_CHARITY_PRICE_ID=price_your-charity-price-id
STRIPE_BETA_PRICE_ID=price_your-beta-price-id

# ── Anthropic (AI draft replies) ──────────────────────────────────────────────
# Found in: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Cloudmersive (virus scanning on uploads) ──────────────────────────────────
# Found in: cloudmersive.com → Account → API Keys
CLOUDMERSIVE_API_KEY=your-key-here

# ── Inbound email webhook ─────────────────────────────────────────────────────
# Shared secret between the Cloudflare Email Worker and /api/inbound-email.
# Generate a random string (e.g. openssl rand -hex 32) and set the same value
# in both Vercel and the Cloudflare Worker environment.
INBOUND_EMAIL_SECRET=your-random-secret-here

# ── Cron jobs ─────────────────────────────────────────────────────────────────
# Secret sent by Vercel Cron in the Authorization header to authenticate
# /api/cron/* routes. Set in Vercel project settings → Environment Variables.
CRON_SECRET=your-random-secret-here

# ── Superadmin ────────────────────────────────────────────────────────────────
# Email address that receives internal notifications (new signups, new tickets, etc.)
SUPERADMIN_EMAIL=hello@alwaysready.uk

# ── Unsubscribe ───────────────────────────────────────────────────────────────
# HMAC secret used to sign and verify unsubscribe tokens in email footers.
# Generate a random string (e.g. openssl rand -hex 32).
UNSUBSCRIBE_SECRET=your-random-secret-here

# ── Upstash Redis (persistent rate limiting) ──────────────────────────────────
# Found in: console.upstash.com → your Redis database → REST API
# Without these, the rate limiter falls back to in-memory (fine for local dev).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ── Cloudflare Turnstile (bot protection on public forms) ────────────────────
# Found in: dash.cloudflare.com → Turnstile → your site
# NEXT_PUBLIC_ key goes in the browser widget; secret key is server-side only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key-here
TURNSTILE_SECRET_KEY=your-secret-key-here

# ── Zeeg (booking webhook auth) ───────────────────────────────────────────────
# Shared secret set in Zeeg webhook settings and verified in /api/inbound-zeeg.
# Generate a random string (e.g. openssl rand -hex 32).
ZEEG_WEBHOOK_TOKEN=your-random-secret-here

# ── Sentry (error monitoring) ─────────────────────────────────────────────────
# Found in: sentry.io → alwaysready-platform → Settings → Client Keys (DSN)
# EU data residency — errors are processed in Germany (ingest.de.sentry.io).
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o123456.ingest.de.sentry.io/789

# ── Superadmin infrastructure dashboard (/superadmin/infrastructure) ─────────
# Optional — each stat card fails closed (returns null, hidden in the UI)
# if its own vars are unset, so these are only needed to see live usage
# numbers for that one internal page.
#
# Sentry: sentry.io → Settings → Auth Tokens (needs org:read); org slug is
# the same "alwaysready-platform" segment as the DSN above.
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG_SLUG=alwaysready-platform

# Upstash: console.upstash.com → Account → Management API
UPSTASH_MANAGEMENT_EMAIL=your-upstash-account-email
UPSTASH_MANAGEMENT_API_KEY=your-upstash-management-api-key
UPSTASH_REDIS_DATABASE_ID=your-upstash-redis-database-id

# Vercel: vercel.com/account/tokens (usage/billing read scope); team ID from
# the team's Settings page.
INFRA_VERCEL_TOKEN=your-vercel-token
INFRA_VERCEL_TEAM_ID=your-vercel-team-id

# Cloudflare: dash.cloudflare.com → My Profile → API Tokens (Workers read scope)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_WORKER_NAME=your-cloudflare-worker-name
