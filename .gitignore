# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Word/Excel lock files (created when a file is open in Word or Excel)
~$*.docx
~$*.dotx
~$*.xlsx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env*
# .env.example is the one exception (no real values, safe to commit)
!.env.example

# vercel
.vercel

# supabase local dev
supabase/.branches
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts
share-certificate-parker-digital.docx

# Playwright (E2E) — reports, traces, and the seeded test-account fixture
# (the fixture holds a real password + TOTP secret for the preview DB's
# test account; never for production, but still not something to commit)
/playwright-report/
/test-results/
/e2e/.fixtures/

# Working documents — not app code, kept locally only
/AlwaysReady-OutreachLetter-Template.docx
/alwaysready-user-testing-brief.docx
/email-footer-mockup.html
/docs/supabase-email-password-changed.html
/docs/supabase-email-reset-password.html
/scripts/create-security-issues.sh
