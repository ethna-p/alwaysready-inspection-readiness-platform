{
  "name": "arplatform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "test:watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest",
    "test:integration": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:browsers": "npm run test:e2e:seed && E2E_BROWSERS=webkit playwright test",
    "test:e2e:seed": "node e2e/support/seed.ts",
    "check:silent-writes": "node scripts/check-silent-writes.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.3",
    "@types/canvas-confetti": "^1.9.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "canvas-confetti": "^1.9.4",
    "file-type": "^22.0.2",
    "jszip": "^3.10.1",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "stripe": "^22.6.0"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "^1.32.0",
    "lightningcss-linux-x64-gnu": "^1.32.0"
  },
  "browserslist": [
    "chrome >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "edge >= 93"
  ],
  "devDependencies": {
    "axe-core": "4.12.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "critters": "^0.0.23",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
